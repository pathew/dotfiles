#!/usr/bin/env bash
# Universal security gate — installed once, runs on every git push for every repo.
# Installed via: git config --global core.hooksPath ~/.config/git/hooks
#
# Runs: Bandit (Python SAST) → Semgrep (taint analysis) → SBOM (CycloneDX) →
#       Grype (CVE scan) → npm audit
#
# Suppress a Bandit false positive:  # nosec B<id>
# Suppress a Semgrep false positive: # nosemgrep: rule-id
# Emergency bypass (use sparingly):  git push --no-verify
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
REPO_NAME="$(basename "$REPO")"
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

pass()  { echo -e "${GREEN}✓ $1${NC}"; }
fail()  { echo -e "${RED}✗ $1${NC}"; GATE_FAILED=1; }
warn()  { echo -e "${YELLOW}⚠ $1${NC}"; }
header(){ echo -e "\n── $1"; }

GATE_FAILED=0

echo ""
echo "╔══════════════════════════════════════════╗"
echo "║  Security gate · $(printf '%-28s' "$REPO_NAME")║"
echo "╚══════════════════════════════════════════╝"

# ─── Auto-detect repo layout ──────────────────────────────────────────────────

# Python requirements file
REQ_FILE=""
for f in "$REPO/requirements.txt" "$REPO/backend/requirements.txt" \
          "$REPO/app/requirements.txt" "$REPO/src/requirements.txt"; do
    [ -f "$f" ] && REQ_FILE="$f" && break
done

# Frontend (package.json)
FRONTEND=""
for d in "$REPO/frontend" "$REPO/interface/web/frontend" \
          "$REPO/client" "$REPO/web" "$REPO/ui"; do
    [ -f "$d/package.json" ] && FRONTEND="$d" && break
done

# Venv dirs to exclude from scanning
BANDIT_EXCLUDE="$REPO/dist,$REPO/build,$REPO/.sbom"
for venv in "$REPO/.venv" "$REPO/venv" "$REPO/backend/.venv" "$REPO/backend/venv" \
            "$REPO/.env" "$REPO/env"; do
    [ -d "$venv" ] && BANDIT_EXCLUDE="$BANDIT_EXCLUDE,$venv"
done
for nd in "$REPO/node_modules" "$REPO/frontend/node_modules" \
          "$REPO/interface/web/frontend/node_modules"; do
    [ -d "$nd" ] && BANDIT_EXCLUDE="$BANDIT_EXCLUDE,$nd"
done

# ─── 1. Bandit — Python SAST ──────────────────────────────────────────────────
header "Bandit (Python SAST)"
if [ -z "$REQ_FILE" ]; then
    warn "Bandit: no requirements.txt found — skipping (not a Python project?)"
elif ! command -v bandit &>/dev/null; then
    warn "Bandit: not installed — skipping (pip3 install bandit)"
else
    BANDIT_OUT=$(bandit -r "$REPO" --exclude "$BANDIT_EXCLUDE" -ll -q 2>&1 || true)
    COUNT=$(echo "$BANDIT_OUT" | grep -c ">> Issue:" || true)
    if [ "$COUNT" -gt 0 ]; then
        fail "Bandit: $COUNT medium/high issue(s) — fix before pushing"
        echo "$BANDIT_OUT" | grep -A3 ">> Issue:" | head -40
    else
        pass "Bandit: clean"
    fi
fi

# ─── 2. Semgrep — taint analysis (Python + TypeScript) ───────────────────────
header "Semgrep (taint analysis)"
if ! command -v semgrep &>/dev/null; then
    warn "Semgrep: not installed — skipping (pip3 install semgrep)"
else
    if semgrep --config=auto --error "$REPO" \
        --exclude .venv --exclude venv \
        --exclude backend/.venv --exclude backend/venv \
        --exclude node_modules --exclude dist --exclude build \
        --quiet 2>&1; then
        pass "Semgrep: clean"
    else
        fail "Semgrep: findings detected — fix before pushing"
    fi
fi

# ─── 3. SBOM + Grype — CVE scan ───────────────────────────────────────────────
header "SBOM + Grype (CVE scan)"
if ! command -v cyclonedx-py &>/dev/null || ! command -v grype &>/dev/null; then
    warn "SBOM scan: cyclonedx-py or grype not installed — skipping"
    warn "  Install: pip3 install cyclonedx-bom && brew install grype"
elif [ -n "$REQ_FILE" ]; then
    mkdir -p "$REPO/.sbom"

    # Python SBOM
    if cyclonedx-py requirements --of JSON \
        -o "$REPO/.sbom/python-sbom.json" "$REQ_FILE" 2>/dev/null; then
        GRYPE_OUT=$(grype "sbom:$REPO/.sbom/python-sbom.json" --output table 2>&1 || true)
        HIGH=$(echo "$GRYPE_OUT" | grep -cE "High|Critical" || true)
        if [ "$HIGH" -gt 0 ]; then
            fail "Grype Python: $HIGH HIGH/CRITICAL CVE(s)"
            echo "$GRYPE_OUT" | grep -E "High|Critical" | head -20
        else
            pass "Grype Python: clean"
        fi
    else
        warn "Grype: SBOM generation failed for $REQ_FILE"
    fi

    # npm SBOM (if frontend present)
    if [ -n "$FRONTEND" ] && [ -f "$FRONTEND/package.json" ]; then
        if (cd "$FRONTEND" && npm sbom --sbom-format cyclonedx \
            --package-lock-only > "$REPO/.sbom/npm-sbom.json" 2>/dev/null); then
            GRYPE_NPM=$(grype "sbom:$REPO/.sbom/npm-sbom.json" --output table 2>&1 || true)
            NPM_HIGH=$(echo "$GRYPE_NPM" | grep -cE "High|Critical" || true)
            if [ "$NPM_HIGH" -gt 0 ]; then
                fail "Grype npm: $NPM_HIGH HIGH/CRITICAL CVE(s)"
                echo "$GRYPE_NPM" | grep -E "High|Critical" | head -20
            else
                pass "Grype npm: clean"
            fi
        else
            warn "Grype npm: SBOM generation skipped (optional platform packages missing)"
        fi
    fi
fi

# ─── 4. npm audit ─────────────────────────────────────────────────────────────
if [ -n "$FRONTEND" ] && [ -f "$FRONTEND/package.json" ]; then
    header "npm audit"
    if (cd "$FRONTEND" && npm audit --audit-level=high 2>&1); then
        pass "npm audit: clean"
    else
        fail "npm audit: high/critical vulnerabilities found"
    fi
fi

# ─── Result ───────────────────────────────────────────────────────────────────
echo ""
if [ "$GATE_FAILED" -eq 0 ]; then
    echo -e "${GREEN}All checks passed — push allowed.${NC}"
    echo ""
    exit 0
else
    echo -e "${RED}Security gate failed — push blocked. Fix findings above, then push again.${NC}"
    echo -e "${YELLOW}Emergency bypass (use sparingly): git push --no-verify${NC}"
    echo ""
    exit 1
fi
